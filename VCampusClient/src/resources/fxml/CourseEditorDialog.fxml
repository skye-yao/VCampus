<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="dialogRoot" prefWidth="470.0" spacing="12.0" styleClass="course-admin-dialog" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.CourseEditorDialogController">
    <padding>
        <Insets bottom="18.0" left="20.0" right="20.0" top="18.0" />
    </padding>
    <children>
        <Label fx:id="dialogTitleLabel" styleClass="course-admin-dialog-title" text="新增课程" />
        <GridPane hgap="10.0" vgap="9.0">
            <columnConstraints>
                <ColumnConstraints minWidth="78.0" prefWidth="78.0" />
                <ColumnConstraints hgrow="ALWAYS" />
            </columnConstraints>
            <children>
                <Label styleClass="course-admin-field-label" text="课程代码" GridPane.rowIndex="0" />
                <TextField fx:id="courseCodeField" promptText="如 CS203" styleClass="course-admin-dialog-field" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                <Label styleClass="course-admin-field-label" text="课程名称" GridPane.rowIndex="1" />
                <TextField fx:id="courseNameField" promptText="如 数据结构" styleClass="course-admin-dialog-field" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                <Label styleClass="course-admin-field-label" text="课程类型" GridPane.rowIndex="2" />
                <ComboBox fx:id="courseTypeField" maxWidth="Infinity" styleClass="course-admin-dialog-field" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                <Label styleClass="course-admin-field-label" text="学分" GridPane.rowIndex="3" />
                <TextField fx:id="creditField" promptText="如 3.0" styleClass="course-admin-dialog-field" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                <Label styleClass="course-admin-field-label" text="学时" GridPane.rowIndex="4" />
                <TextField fx:id="creditHoursField" promptText="如 48" styleClass="course-admin-dialog-field" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                <Label styleClass="course-admin-field-label" text="先修课程" GridPane.rowIndex="5" />
                <TextField fx:id="prerequisitesField" promptText="无则留空" styleClass="course-admin-dialog-field" GridPane.columnIndex="1" GridPane.rowIndex="5" />
            </children>
        </GridPane>
        <VBox spacing="4.0">
            <children>
                <Label styleClass="course-admin-field-label" text="课程简介" />
                <TextArea fx:id="descriptionField" prefHeight="68.0" prefRowCount="3" promptText="课程内容简介" styleClass="course-admin-dialog-area" wrapText="true" />
            </children>
        </VBox>
        <HBox spacing="18.0">
            <children>
                <CheckBox fx:id="allowCrossMajorField" styleClass="course-admin-dialog-check" text="允许跨专业选修" />
                <CheckBox fx:id="finalExamField" styleClass="course-admin-dialog-check" text="需要期末考试" />
            </children>
        </HBox>
        <Label fx:id="validationLabel" managed="false" styleClass="course-admin-validation-text" text="" visible="false" />
        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <children>
                <Button fx:id="cancelButton" onAction="#handleCancel" styleClass="course-admin-dialog-cancel" text="取消" />
                <Button fx:id="saveButton" defaultButton="true" onAction="#handleSave" styleClass="course-admin-dialog-save" text="保存" />
            </children>
        </HBox>
    </children>
</VBox>
