<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="dialogRoot" prefWidth="860.0" prefHeight="580.0" spacing="10.0" styleClass="course-admin-dialog, course-admin-enrollment-dialog" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.AddOfferingStudentDialogController">
    <padding>
        <Insets bottom="16.0" left="20.0" right="20.0" top="16.0" />
    </padding>
    <children>
        <Label styleClass="course-admin-dialog-title" text="添加学生" />
        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <children>
                <Label fx:id="offeringContextLabel" styleClass="course-admin-enrollment-context" text="" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="selectedStudentLabel" styleClass="course-admin-enrollment-context" text="未选择学生" />
            </children>
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="8.0">
            <children>
                <TextField fx:id="queryField" promptText="按学号或姓名搜索学生" styleClass="course-admin-dialog-field" HBox.hgrow="ALWAYS" />
                <Button fx:id="searchButton" onAction="#handleSearch" styleClass="course-admin-action" text="搜索" />
            </children>
        </HBox>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" minHeight="0.0" styleClass="course-admin-enrollment-scroll" VBox.vgrow="ALWAYS">
            <content>
                <VBox spacing="8.0">
                    <padding><Insets right="10.0" /></padding>
                    <children>
                        <Label fx:id="resultLoadingLabel" managed="false" styleClass="course-admin-loading-text" text="正在搜索学生..." visible="false" />
                        <Label fx:id="resultErrorLabel" managed="false" styleClass="course-admin-error-text" text="" visible="false" />
                        <Button fx:id="resultRetryButton" managed="false" onAction="#handleRetry" styleClass="course-admin-action" text="重试" visible="false" />
                        <Label fx:id="resultEmptyLabel" managed="false" styleClass="course-admin-placeholder-text" text="没有匹配的学生" visible="false" />
                        <VBox fx:id="studentResultList" spacing="6.0" styleClass="course-admin-student-list" />
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <children>
                                <Label fx:id="paginationLabel" managed="false" styleClass="course-admin-pagination-text" text="" visible="false" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Button fx:id="prevPageButton" managed="false" onAction="#handlePrevPage" styleClass="course-admin-action" text="上一页" visible="false" />
                                <Button fx:id="nextPageButton" managed="false" onAction="#handleNextPage" styleClass="course-admin-action" text="下一页" visible="false" />
                            </children>
                        </HBox>
                        <Label fx:id="riskSummaryLabel" managed="false" styleClass="course-admin-conflict-summary" text="" visible="false" />
                        <VBox fx:id="riskArea" spacing="4.0" />
                        <TextField fx:id="overrideReasonField" disable="true" promptText="填写强制加入原因（仅可绕过风险需要）" styleClass="course-admin-dialog-field" />
                    </children>
                </VBox>
            </content>
        </ScrollPane>
        <Label fx:id="validationLabel" managed="false" styleClass="course-admin-validation-text" text="" visible="false" />
        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <children>
                <Button fx:id="cancelButton" onAction="#handleCancel" styleClass="course-admin-dialog-cancel" text="取消" />
                <Button fx:id="previewButton" disable="true" onAction="#handlePreview" styleClass="course-admin-action" text="查看风险预览" />
                <Button fx:id="forceAddButton" managed="false" onAction="#handleForceAdd" styleClass="course-admin-force-save" text="填写原因并加入" visible="false" />
                <Button fx:id="addButton" defaultButton="true" disable="true" onAction="#handleAdd" styleClass="course-admin-dialog-save" text="加入教学班" />
            </children>
        </HBox>
    </children>
</VBox>
