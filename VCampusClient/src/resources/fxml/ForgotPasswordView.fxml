<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="rootForgot" prefHeight="680.0" prefWidth="396.0" styleClass="login-background" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.ForgotPasswordController">
    <children>
        <VBox alignment="TOP_CENTER" maxWidth="380.0" spacing="12.0" styleClass="login-card">
            <padding>
                <Insets bottom="24.0" left="28.0" right="28.0" top="24.0" />
            </padding>
            <children>
                <!-- 头部标题 -->
                <VBox alignment="CENTER" spacing="4.0">
                    <children>
                        <Label styleClass="login-title" text="找回密码" />
                        <Label styleClass="login-subtitle" text="东南大学 · 虚拟校园系统" />
                    </children>
                </VBox>

                <!-- 一卡通号 -->
                <VBox spacing="4.0">
                    <children>
                        <Label styleClass="form-label" text="一卡通号 (UID)" />
                        <TextField fx:id="uidField" prefHeight="36.0" promptText="请输入一卡通号" styleClass="form-control" />
                    </children>
                </VBox>

                <!-- 预留手机号 -->
                <VBox spacing="4.0">
                    <children>
                        <Label styleClass="form-label" text="预留手机号" />
                        <TextField fx:id="phoneField" prefHeight="36.0" promptText="请输入绑定的11位手机号" styleClass="form-control" />
                    </children>
                </VBox>

                <!-- 短信验证码 -->
                <VBox spacing="4.0">
                    <children>
                        <Label styleClass="form-label" text="短信验证码" />
                        <HBox spacing="10.0">
                            <children>
                                <TextField fx:id="codeField" prefHeight="36.0" promptText="6位数字验证码" styleClass="form-control" HBox.hgrow="ALWAYS" />
                                <Button fx:id="sendCodeBtn" onAction="#handleSendCode" prefHeight="36.0" prefWidth="110.0" styleClass="btn-secondary" text="获取验证码" />
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <!-- 新密码 -->
                <VBox spacing="4.0">
                    <children>
                        <Label styleClass="form-label" text="设置新密码" />
                        <PasswordField fx:id="newPasswordField" prefHeight="36.0" promptText="请输入新密码（至少6位）" styleClass="form-control" />
                    </children>
                </VBox>

                <!-- 确认新密码 -->
                <VBox spacing="4.0">
                    <children>
                        <Label styleClass="form-label" text="确认新密码" />
                        <PasswordField fx:id="confirmPasswordField" prefHeight="36.0" promptText="请再次输入新密码" styleClass="form-control" />
                    </children>
                </VBox>

                <!-- 密码复杂度提示 -->
                <Label style="-fx-font-size: 11px; -fx-text-fill: #727e72;" text="* 密码要求：长度不能少于6位" wrapText="true" />

                <!-- 重置密码按钮 -->
                <Button fx:id="resetBtn" maxWidth="1.7976931348623157E308" onAction="#handleResetPassword" prefHeight="40.0" styleClass="btn-primary" text="重 置 密 码">
                    <VBox.margin>
                        <Insets top="4.0" />
                    </VBox.margin>
                </Button>

                <!-- 返回登录快捷链接 -->
                <HBox alignment="CENTER">
                    <children>
                        <Hyperlink onAction="#handleBackToLogin" styleClass="login-link" text="记起密码了？返回登录" />
                    </children>
                    <VBox.margin>
                        <Insets top="4.0" />
                    </VBox.margin>
                </HBox>
            </children>
        </VBox>
    </children>
</StackPane>
