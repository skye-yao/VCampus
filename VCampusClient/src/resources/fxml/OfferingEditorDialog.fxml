<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="dialogRoot" prefWidth="470.0" spacing="12.0" styleClass="course-admin-dialog" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.OfferingEditorDialogController">
    <padding>
        <Insets bottom="18.0" left="20.0" right="20.0" top="18.0" />
    </padding>
    <children>
        <Label fx:id="dialogTitleLabel" styleClass="course-admin-dialog-title" text="新增教学班" />
        <GridPane hgap="10.0" vgap="9.0">
            <columnConstraints>
                <ColumnConstraints minWidth="92.0" prefWidth="92.0" />
                <ColumnConstraints hgrow="ALWAYS" />
            </columnConstraints>
            <children>
                <Label styleClass="course-admin-field-label" text="教学班代码" GridPane.rowIndex="0" />
                <TextField fx:id="offeringCodeField" promptText="如 OFF-1001" styleClass="course-admin-dialog-field" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                <Label styleClass="course-admin-field-label" text="学年" GridPane.rowIndex="1" />
                <TextField fx:id="academicYearField" promptText="如 2027" styleClass="course-admin-dialog-field" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                <Label styleClass="course-admin-field-label" text="学期" GridPane.rowIndex="2" />
                <ComboBox fx:id="semesterField" maxWidth="Infinity" styleClass="course-admin-dialog-field" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                <Label styleClass="course-admin-field-label" text="容量" GridPane.rowIndex="3" />
                <TextField fx:id="capacityField" promptText="如 60" styleClass="course-admin-dialog-field" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                <Label styleClass="course-admin-field-label" text="任课教师工号" GridPane.rowIndex="4" />
                <TextField fx:id="teacherUidField" promptText="如 T1001" styleClass="course-admin-dialog-field" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                <Label styleClass="course-admin-field-label" text="助教工号" GridPane.rowIndex="5" />
                <TextField fx:id="assistantUidField" promptText="无则留空" styleClass="course-admin-dialog-field" GridPane.columnIndex="1" GridPane.rowIndex="5" />
                <Label styleClass="course-admin-field-label" text="状态" GridPane.rowIndex="6" />
                <ComboBox fx:id="statusField" maxWidth="Infinity" styleClass="course-admin-dialog-field" GridPane.columnIndex="1" GridPane.rowIndex="6" />
            </children>
        </GridPane>
        <Label fx:id="validationLabel" managed="false" styleClass="course-admin-validation-text" text="" visible="false" />
        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <children>
                <Button fx:id="cancelButton" onAction="#handleCancel" styleClass="course-admin-dialog-cancel" text="取消" />
                <Button fx:id="saveButton" defaultButton="true" onAction="#handleSave" styleClass="course-admin-dialog-save" text="保存" />
            </children>
        </HBox>
    </children>
</VBox>
