<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="course-schedule-page" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.ScheduleController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="course-toolbar" BorderPane.alignment="CENTER">
            <children>
                <Label text="学年学期" />
                <ComboBox fx:id="termFilter" prefWidth="168.0" styleClass="course-type-filter" />
                <Label text="周次" />
                <Spinner fx:id="weekSpinner" editable="true" prefWidth="92.0" />
                <Button fx:id="currentWeekButton" onAction="#handleBackToCurrentWeek" styleClass="course-refresh-button" text="回到本周" />
                <Region HBox.hgrow="ALWAYS" />
                <Button onAction="#refresh" styleClass="course-refresh-button" text="刷新" />
            </children>
            <BorderPane.margin>
                <Insets bottom="12.0" />
            </BorderPane.margin>
        </HBox>
    </top>
    <center>
        <GridPane fx:id="scheduleGrid" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" styleClass="course-schedule-grid" BorderPane.alignment="CENTER" />
    </center>
    <right>
        <VBox fx:id="noticeList" prefWidth="168.0" spacing="10.0" styleClass="course-notice-rail" BorderPane.alignment="TOP_CENTER">
            <BorderPane.margin>
                <Insets left="14.0" />
            </BorderPane.margin>
        </VBox>
    </right>
</BorderPane>
