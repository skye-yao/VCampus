<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!--
  课次详情弹窗（设计 §3）：由 TeacherScheduleController 用独立 WINDOW_MODAL Stage 打开，Stage 标题固定为
  “课程详情”。条目字段、原/新安排与原因全部原样来自不可变的 DTO；教学班与人数来自权威快照。
  “申请调课”已接通：它默认禁用，由控制器按“课次确实可申请、且这次弹窗里还没提交过”启停，
  因此这里只写可写的 disable="true"（JavaFX 的 disabled 是只读属性）。
-->
<VBox fx:id="dialogRoot" prefWidth="520.0" spacing="12.0" styleClass="teacher-course-dialog" stylesheets="@../css/style.css, @../css/teacher-course.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.TeacherCourseDetailDialogController">
    <children>
        <Label fx:id="dialogTitleLabel" styleClass="teacher-course-dialog-title" text="课程详情" />
        <VBox spacing="6.0" styleClass="teacher-schedule-dialog-section">
            <children>
                <Label fx:id="courseCodeLine" styleClass="teacher-schedule-dialog-line" text="" />
                <Label fx:id="courseNameLine" styleClass="teacher-schedule-dialog-line" text="" />
                <Label fx:id="teacherLine" styleClass="teacher-schedule-dialog-line" text="" />
                <Label fx:id="timeLine" styleClass="teacher-schedule-dialog-line" text="" />
                <Label fx:id="locationLine" styleClass="teacher-schedule-dialog-line" text="" />
                <Label fx:id="weekLine" styleClass="teacher-schedule-dialog-line" text="" />
            </children>
        </VBox>
        <VBox fx:id="adjustmentBox" managed="false" spacing="6.0" styleClass="teacher-schedule-dialog-adjustment" visible="false">
            <children>
                <Label fx:id="originalScheduleLine" styleClass="teacher-schedule-dialog-adjustment-line" text="" />
                <Label fx:id="adjustedScheduleLine" styleClass="teacher-schedule-dialog-adjustment-line" text="" />
                <Label fx:id="adjustmentReasonLine" styleClass="teacher-schedule-dialog-adjustment-line" text="" />
            </children>
        </VBox>
        <VBox spacing="6.0" styleClass="teacher-schedule-dialog-section">
            <children>
                <Label fx:id="offeringLine" styleClass="teacher-schedule-dialog-line" text="" />
                <Label fx:id="rosterLine" managed="false" styleClass="teacher-schedule-dialog-line" text="" visible="false" />
                <Label fx:id="rosterErrorLabel" managed="false" styleClass="teacher-course-error-text" text="" visible="false" />
                <Button fx:id="rosterRetryButton" managed="false" onAction="#retry" styleClass="teacher-course-retry-button" text="重试" visible="false" />
            </children>
        </VBox>
        <Label fx:id="adjustmentHintLabel" managed="false" styleClass="teacher-schedule-dialog-hint" text="" visible="false" />
        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <children>
                <Button fx:id="requestAdjustmentButton" disable="true" onAction="#handleRequestAdjustment" styleClass="teacher-course-page-button" text="申请调课" />
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="openOfferingButton" onAction="#handleOpenOffering" styleClass="teacher-course-page-button" text="查看教学班" />
                <Button fx:id="closeButton" onAction="#handleClose" styleClass="teacher-course-back-button" text="关闭" />
            </children>
        </HBox>
    </children>
    <padding>
        <Insets bottom="16.0" left="20.0" right="20.0" top="16.0" />
    </padding>
</VBox>
