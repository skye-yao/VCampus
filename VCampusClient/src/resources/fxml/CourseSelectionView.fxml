<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="course-selection-page" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.CourseSelectionController">
    <fx:define>
        <ToggleGroup fx:id="statusToggleGroup" />
    </fx:define>
    <top>
        <VBox spacing="10.0" BorderPane.alignment="CENTER">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="course-toolbar">
                    <children>
                        <TextField fx:id="searchField" promptText="搜索课程名称或代码" styleClass="course-search-field" HBox.hgrow="ALWAYS" />
                        <ComboBox fx:id="termFilter" prefWidth="154.0" promptText="学期" styleClass="course-term-filter" />
                        <ComboBox fx:id="typeFilter" prefWidth="118.0" promptText="课程类型" styleClass="course-type-filter" />
                        <Button onAction="#refresh" styleClass="course-refresh-button" text="搜索" />
                    </children>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="4.0" styleClass="course-subnav">
                    <children>
                        <ToggleButton fx:id="allTabButton" onAction="#showAllCourses" selected="true" styleClass="course-subnav-button" text="全部" toggleGroup="$statusToggleGroup" />
                        <ToggleButton fx:id="planTabButton" onAction="#showPlannedCourses" styleClass="course-subnav-button" text="计划" toggleGroup="$statusToggleGroup" />
                        <ToggleButton fx:id="waitlistTabButton" onAction="#showWaitlistedCourses" styleClass="course-subnav-button" text="候补" toggleGroup="$statusToggleGroup" />
                        <ToggleButton fx:id="enrolledTabButton" onAction="#showEnrolledCourses" styleClass="course-subnav-button" text="已选" toggleGroup="$statusToggleGroup" />
                    </children>
                </HBox>
            </children>
            <padding>
                <Insets bottom="12.0" />
            </padding>
        </VBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" pannable="true" styleClass="course-list-scroll" BorderPane.alignment="CENTER">
            <content>
                <VBox fx:id="courseList" fillWidth="true" spacing="8.0" styleClass="course-list" />
            </content>
        </ScrollPane>
    </center>
    <right>
        <VBox prefWidth="142.0" spacing="14.0" styleClass="course-summary-rail" BorderPane.alignment="TOP_CENTER">
            <children>
                <Label styleClass="course-summary-title" text="课程分类" />
                <VBox spacing="3.0" styleClass="course-summary-item">
                    <children>
                        <Label styleClass="course-summary-label" text="必修课程" />
                        <Label fx:id="requiredCountLabel" styleClass="course-summary-value" text="0 门" />
                    </children>
                </VBox>
                <VBox spacing="3.0" styleClass="course-summary-item">
                    <children>
                        <Label styleClass="course-summary-label" text="限选 / 选修" />
                        <Label fx:id="electiveCountLabel" styleClass="course-summary-value" text="0 门" />
                    </children>
                </VBox>
                <VBox spacing="3.0" styleClass="course-summary-item">
                    <children>
                        <Label styleClass="course-summary-label" text="通选课程" />
                        <Label fx:id="generalCountLabel" styleClass="course-summary-value" text="0 门" />
                    </children>
                </VBox>
            </children>
            <BorderPane.margin>
                <Insets left="16.0" />
            </BorderPane.margin>
        </VBox>
    </right>
</BorderPane>
