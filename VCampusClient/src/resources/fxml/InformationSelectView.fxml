<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?><?import javafx.scene.control.*?><?import javafx.scene.layout.*?>
<StackPane stylesheets="@../css/style.css,@../css/information-select.css" xmlns="http://javafx.com/javafx/25.0.4" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.InformationSelectController" styleClass="information-select-page">
 <VBox alignment="CENTER" maxWidth="620" maxHeight="620" spacing="24" styleClass="information-select-card"><padding><Insets bottom="36" left="42" right="42" top="36"/></padding>
  <Label styleClass="information-select-title" text="基本信息"/><Label styleClass="information-select-subtitle" text="请选择需要管理的信息"/>
  <Button maxWidth="Infinity" minHeight="86" onAction="#openStudent" styleClass="information-select-option" text="学生信息"/>
  <Button maxWidth="Infinity" minHeight="86" onAction="#openTeacher" styleClass="information-select-option" text="教师信息"/>
  <VBox alignment="CENTER" styleClass="information-select-footer"><Button onAction="#back" styleClass="information-select-back" text="← 返回应用中心"/></VBox>
 </VBox>
</StackPane>
