<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<SplitPane dividerPositions="0.58" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="controller.LibraryAdminController">
    <items>
        <VBox spacing="9.0" styleClass="content-pane">
            <padding><Insets bottom="12.0" left="12.0" right="8.0" top="12.0"/></padding>
            <HBox spacing="8.0">
                <TextField fx:id="adminSearchField" onAction="#handleAdminSearch" promptText="搜索馆藏" HBox.hgrow="ALWAYS"/>
                <Button onAction="#handleAdminSearch" styleClass="btn-primary" text="搜索"/>
                <Button onAction="#handleAdminRecords" styleClass="btn-secondary" text="业务名单"/>
                <Button onAction="#handleCirculation" styleClass="btn-primary" text="借还与缴费"/>
            </HBox>
            <TableView fx:id="adminBookTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="adminIdColumn" prefWidth="70.0" text="书目编号"/>
                    <TableColumn fx:id="adminNameColumn" text="书名"/>
                    <TableColumn fx:id="adminAuthorColumn" text="作者"/>
                    <TableColumn fx:id="adminIsbnColumn" text="ISBN"/>
                    <TableColumn fx:id="adminTotalColumn" prefWidth="65.0" text="总册数"/>
                    <TableColumn fx:id="adminAvailableColumn" prefWidth="75.0" text="可借数量"/>
                    <TableColumn fx:id="adminStatusColumn" prefWidth="85.0" text="状态"/>
                </columns>
            </TableView>
        </VBox>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER">
        <content>
        <VBox spacing="7.0" styleClass="admin-form">
            <padding><Insets bottom="18.0" left="18.0" right="18.0" top="18.0"/></padding>
            <Label styleClass="panel-title" text="图书信息"/>
            <Label text="书目编号（自动生成）"/><TextField fx:id="idField" editable="false" promptText="每册的独立编号可在馆藏册列表中查看"/>
            <Label text="ISBN *"/><TextField fx:id="isbnField"/>
            <Label text="书名 *"/><TextField fx:id="nameField"/>
            <Label text="作者 *"/><TextField fx:id="authorField"/>
            <Label text="出版社"/><TextField fx:id="publisherField"/>
            <Label text="图书价格（元）"/><TextField fx:id="priceField" promptText="借出前必须录入，用于遗失赔偿"/>
            <Label text="新增 / 补充册数"/><TextField fx:id="copyCountField" text="1" promptText="1 到 1000，每册自动生成独立册号"/>
            <Label text="保存修改只更新书目信息。补充库存请点击增加馆藏册；挂失册找回请进入馆藏册列表。" wrapText="true"/>
            <Button maxWidth="Infinity" onAction="#handleAddCopies" styleClass="btn-primary" text="为选中书目增加馆藏册"/>
            <Region VBox.vgrow="ALWAYS"/>
            <GridPane hgap="8.0" vgap="8.0">
                <columnConstraints><ColumnConstraints percentWidth="50.0"/><ColumnConstraints percentWidth="50.0"/></columnConstraints>
                <Button maxWidth="Infinity" onAction="#handleAddBook" styleClass="btn-primary" text="新增上架" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <Button maxWidth="Infinity" onAction="#handleUpdateBook" styleClass="btn-secondary" text="保存修改" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                <Button maxWidth="Infinity" onAction="#handleQueryStatus" styleClass="btn-secondary" text="查看馆藏册" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <Button maxWidth="Infinity" onAction="#handleRemoveBook" styleClass="btn-danger-soft" text="下架图书" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
            </GridPane>
            <Button maxWidth="Infinity" onAction="#handleClearForm" text="清空表单"/>
        </VBox>
        </content>
        </ScrollPane>
    </items>
</SplitPane>
