<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.GradeController">
    <children>
        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="course-toolbar">
            <children>
                <Label text="学年学期" />
                <ComboBox fx:id="termFilter" prefWidth="168.0" styleClass="course-type-filter" />
                <Region HBox.hgrow="ALWAYS" />
                <Button onAction="#refresh" styleClass="course-refresh-button" text="刷新" />
            </children>
        </HBox>
        <HBox spacing="8.0" styleClass="course-metrics">
            <children>
                <VBox maxWidth="1.7976931348623157E308" spacing="2.0" styleClass="course-metric" HBox.hgrow="ALWAYS">
                    <children>
                        <Label styleClass="course-summary-label" text="学期绩点" />
                        <Label fx:id="termGpaLabel" styleClass="course-metric-value" text="--" />
                    </children>
                </VBox>
                <VBox maxWidth="1.7976931348623157E308" spacing="2.0" styleClass="course-metric" HBox.hgrow="ALWAYS">
                    <children>
                        <Label styleClass="course-summary-label" text="学期平均分" />
                        <Label fx:id="termAverageLabel" styleClass="course-metric-value" text="--" />
                    </children>
                </VBox>
                <VBox maxWidth="1.7976931348623157E308" spacing="2.0" styleClass="course-metric" HBox.hgrow="ALWAYS">
                    <children>
                        <Label styleClass="course-summary-label" text="累计平均分" />
                        <Label fx:id="cumulativeAverageLabel" styleClass="course-metric-value" text="--" />
                    </children>
                </VBox>
                <VBox maxWidth="1.7976931348623157E308" spacing="2.0" styleClass="course-metric" HBox.hgrow="ALWAYS">
                    <children>
                        <Label styleClass="course-summary-label" text="累计绩点" />
                        <Label fx:id="cumulativeGpaLabel" styleClass="course-metric-value" text="--" />
                    </children>
                </VBox>
            </children>
        </HBox>
        <BorderPane VBox.vgrow="ALWAYS">
            <center>
                <StackPane BorderPane.alignment="CENTER">
                    <children>
                        <TableView fx:id="gradeTable" styleClass="course-grade-table">
                            <columns>
                                <TableColumn fx:id="courseNameColumn" minWidth="120.0" prefWidth="152.0" text="课程" />
                                <TableColumn fx:id="courseCodeColumn" minWidth="82.0" prefWidth="94.0" text="课程代码" />
                                <TableColumn fx:id="creditColumn" minWidth="54.0" prefWidth="60.0" text="学分" />
                                <TableColumn fx:id="scoreColumn" minWidth="54.0" prefWidth="60.0" text="总评" />
                                <TableColumn fx:id="gpaColumn" minWidth="54.0" prefWidth="60.0" text="绩点" />
                            </columns>
                        </TableView>
                        <Label fx:id="emptyStateLabel" managed="false" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" styleClass="course-empty-state" text="请选择学期" visible="false" />
                    </children>
                </StackPane>
            </center>
            <right>
                <VBox maxWidth="184.0" minWidth="184.0" prefWidth="184.0" spacing="12.0" styleClass="course-grade-detail" BorderPane.alignment="TOP_CENTER">
                    <children>
                        <Label maxWidth="1.7976931348623157E308" styleClass="course-summary-title" text="成绩组成" />
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <children>
                                <Label styleClass="course-summary-label" text="平时成绩" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="dailyScoreLabel" styleClass="course-score-value" text="--" />
                            </children>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <children>
                                <Label styleClass="course-summary-label" text="期中成绩" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="midtermScoreLabel" styleClass="course-score-value" text="--" />
                            </children>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <children>
                                <Label styleClass="course-summary-label" text="实验成绩" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="experimentScoreLabel" styleClass="course-score-value" text="--" />
                            </children>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <children>
                                <Label styleClass="course-summary-label" text="期末成绩" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="finalScoreLabel" styleClass="course-score-value" text="--" />
                            </children>
                        </HBox>
                        <Region minHeight="1.0" prefHeight="1.0" />
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <children>
                                <Label styleClass="course-summary-label" text="总评成绩" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="totalScoreLabel" styleClass="course-score-value" text="--" />
                            </children>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <children>
                                <Label styleClass="course-summary-label" text="课程绩点" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="detailGpaLabel" styleClass="course-score-value" text="--" />
                            </children>
                        </HBox>
                    </children>
                    <BorderPane.margin>
                        <Insets left="12.0" />
                    </BorderPane.margin>
                </VBox>
            </right>
        </BorderPane>
    </children>
</VBox>
