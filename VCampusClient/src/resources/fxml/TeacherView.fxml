<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import util.control.InformationReviewStatusPane?>
<?import util.control.SearchClearButton?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" prefHeight="580" prefWidth="860" styleClass="main-window" stylesheets="@../css/style.css" fx:controller="controller.TeacherController">
  <top><HBox alignment="CENTER_LEFT" prefHeight="56" spacing="12" styleClass="app-topbar"><padding><Insets left="22" right="22"/></padding><Button onAction="#back" styleClass="btn-back" text="← 返回"/><Label styleClass="brand-title" text="我的信息"/><ComboBox fx:id="switchInformationSelector" onAction="#switchToStudents" prefWidth="150" visible="false" managed="false"/><Region HBox.hgrow="ALWAYS"/><Button onAction="#refresh" styleClass="btn-secondary" text="刷新"/></HBox></top>
  <center><TabPane fx:id="tabs" tabClosingPolicy="UNAVAILABLE" styleClass="student-tab-pane"><tabs>
    <Tab fx:id="overviewTab" text="教师基本信息"><ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="student-scroll"><VBox fx:id="overviewPane" spacing="16" styleClass="student-page"><padding><Insets bottom="22" left="25" right="25" top="20"/></padding>
      <HBox alignment="CENTER_LEFT" spacing="18" styleClass="student-hero"><StackPane minHeight="82" minWidth="82" prefHeight="82" prefWidth="82" maxHeight="82" maxWidth="82" styleClass="student-avatar"><Label fx:id="avatarLabel" styleClass="avatar-text-xl" text="师"/></StackPane><VBox spacing="7" HBox.hgrow="ALWAYS"><Label fx:id="nameLabel" styleClass="profile-name-title" text="正在加载"/><Label fx:id="metaLabel" styleClass="student-meta" text="工号 · 学院 · 部门 · 职称"/></VBox><VBox spacing="8"><Button onAction="#viewDetails" styleClass="btn-primary" text="查看详情 →"/><Button onAction="#viewExperiences" styleClass="btn-primary" text="查看经历 →"/></VBox></HBox>
      <Label styleClass="student-section-title" text="我的信息"/><GridPane hgap="12"><columnConstraints><ColumnConstraints percentWidth="25"/><ColumnConstraints percentWidth="25"/><ColumnConstraints percentWidth="25"/><ColumnConstraints percentWidth="25"/></columnConstraints>
        <VBox spacing="7" styleClass="student-stat-card"><Label styleClass="hint-text" text="任职状态"/><Label fx:id="overviewStatusValue" styleClass="student-stat-value" text="-"/></VBox>
        <VBox spacing="7" styleClass="student-stat-card" GridPane.columnIndex="1"><Label styleClass="hint-text" text="教师职称"/><Label fx:id="overviewTitleValue" styleClass="student-stat-value" text="-"/></VBox>
        <VBox spacing="7" styleClass="student-stat-card" GridPane.columnIndex="2"><Label styleClass="hint-text" text="所属学院"/><Label fx:id="overviewCollegeValue" styleClass="student-stat-value" text="-"/></VBox>
        <VBox spacing="7" styleClass="student-stat-card" GridPane.columnIndex="3"><Label styleClass="hint-text" text="是否在职"/><Label fx:id="overviewEmployedValue" styleClass="student-stat-value" text="-"/></VBox>
      </GridPane>
    </VBox></ScrollPane></Tab>
    <Tab fx:id="detailTab" text="教师详情"><BorderPane fx:id="detailPane" styleClass="student-page"><left><VBox alignment="TOP_CENTER" prefWidth="172" spacing="10" styleClass="student-sidebar"><padding><Insets left="14" right="14" top="24"/></padding><StackPane minHeight="70" minWidth="70" prefHeight="70" prefWidth="70" maxHeight="70" maxWidth="70" styleClass="student-avatar"><Label fx:id="sideAvatarLabel" styleClass="avatar-text-lg" text="师"/></StackPane><Label fx:id="sideNameLabel" styleClass="student-side-name" text="教师姓名"/><Label fx:id="sideMetaLabel" styleClass="hint-text" text="部门"/><Separator/><Button maxWidth="Infinity" onAction="#showBase" styleClass="student-side-button-active" text="个人基本信息"/><Button maxWidth="Infinity" onAction="#showJob" styleClass="student-side-button" text="任职信息"/><Button maxWidth="Infinity" onAction="#showContact" styleClass="student-side-button" text="联系信息"/><Separator/><Button fx:id="exportPdfButton" maxWidth="Infinity" onAction="#exportTeacherPdf" styleClass="student-export-button" text="↓ 导出信息"/></VBox></left>

      <center><ScrollPane fx:id="detailScroll" fitToHeight="false" fitToWidth="true" hbarPolicy="AS_NEEDED" pannable="true" styleClass="student-scroll" vbarPolicy="AS_NEEDED"><HBox alignment="TOP_LEFT"><VBox minWidth="1080" spacing="12"><padding><Insets bottom="20" left="20" right="22" top="18"/></padding><Button alignment="CENTER_LEFT" onAction="#returnOverview" styleClass="btn-secondary" text="← 返回信息总览"/>
        <VBox fx:id="baseSection" spacing="10" styleClass="student-panel"><HBox alignment="CENTER_LEFT"><Label styleClass="student-section-title" text="个人基本信息"/><Region HBox.hgrow="ALWAYS"/><Button fx:id="editButton" onAction="#edit" styleClass="student-edit-link" text="编辑"/></HBox><GridPane fx:id="baseGrid" hgap="12" vgap="9"/></VBox>
        <VBox fx:id="jobSection" spacing="10" styleClass="student-panel"><HBox alignment="CENTER_LEFT"><Label styleClass="student-section-title" text="任职信息"/><Region HBox.hgrow="ALWAYS"/><Button fx:id="jobEditButton" onAction="#edit" styleClass="student-edit-link" text="编辑"/></HBox><GridPane fx:id="jobGrid" hgap="12" vgap="9"/></VBox>
        <VBox fx:id="contactSection" spacing="10" styleClass="student-panel"><HBox alignment="CENTER_LEFT"><Label styleClass="student-section-title" text="联系信息"/><Region HBox.hgrow="ALWAYS"/><Button fx:id="contactEditButton" onAction="#edit" styleClass="student-edit-link" text="编辑"/></HBox><GridPane fx:id="contactGrid" hgap="12" vgap="9"/></VBox>
        <VBox spacing="10" styleClass="student-panel"><Label styleClass="student-section-title" text="个人经历 · 工作经历"/><VBox fx:id="detailExperienceCards" spacing="10" fillWidth="true"/></VBox>
        <VBox spacing="10" styleClass="student-panel"><Label styleClass="student-section-title" text="主要社会关系"/><VBox fx:id="detailFamilyCards" spacing="10" fillWidth="true"/></VBox>
      </VBox><InformationReviewStatusPane fx:id="reviewStatusPane" submitter="教师" HBox.hgrow="ALWAYS"/></HBox></ScrollPane></center></BorderPane></Tab>
    <Tab fx:id="experienceTab" text="个人经历"><ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="student-scroll"><VBox spacing="14" styleClass="student-page"><padding><Insets bottom="20" left="24" right="24" top="18"/></padding>
      <Button alignment="CENTER_LEFT" onAction="#backFromExperiences" styleClass="btn-secondary" text="← 返回信息总览"/>
      <VBox spacing="10" styleClass="student-panel"><HBox alignment="CENTER_LEFT" spacing="8"><Label styleClass="student-section-title" text="我的工作经历"/><Region HBox.hgrow="ALWAYS"/><Button onAction="#addWorkExperience" styleClass="btn-primary" text="添加经历"/><Button fx:id="editExperienceButton" disable="true" onAction="#editWorkExperience" styleClass="btn-secondary" text="编辑选中"/><Button fx:id="deleteExperienceButton" disable="true" onAction="#deleteWorkExperience" styleClass="btn-secondary" text="删除选中"/></HBox>
        <VBox fx:id="experienceCardContainer" fillWidth="true" spacing="10"/>
      </VBox>
      <VBox spacing="10" styleClass="student-panel">
        <HBox alignment="CENTER_LEFT" spacing="8">
          <Label styleClass="student-section-title" text="主要社会关系"/>
          <Region HBox.hgrow="ALWAYS"/>
          <Button onAction="#addFamilyMember" styleClass="btn-primary" text="添加成员"/>
          <Button fx:id="editFamilyButton" disable="true" onAction="#editFamilyMember" styleClass="btn-secondary" text="编辑选中"/>
          <Button fx:id="deleteFamilyButton" disable="true" onAction="#deleteFamilyMember" styleClass="btn-secondary" text="删除选中"/>
        </HBox>
        <VBox fx:id="familyCardContainer" spacing="10" fillWidth="true"/>
      </VBox>
    </VBox></ScrollPane></Tab>
    <Tab fx:id="adminTab" text="教师列表"><BorderPane styleClass="student-page"><left><VBox alignment="TOP_CENTER" prefWidth="160" spacing="12" styleClass="student-sidebar"><padding><Insets left="14" right="14" top="24"/></padding><StackPane minHeight="70" minWidth="70" prefHeight="70" prefWidth="70" maxHeight="70" maxWidth="70" styleClass="student-avatar"><Label styleClass="avatar-text-lg" text="管"/></StackPane><Label styleClass="student-side-name" text="管理员"/><Button fx:id="managementNavButton" maxWidth="Infinity" onAction="#selectAdmin" styleClass="student-side-button-active" text="教师信息管理"/><Button fx:id="maintenanceNavButton" maxWidth="Infinity" onAction="#selectMaintenance" styleClass="student-side-button" text="教师信息维护"/><Button maxWidth="Infinity" onAction="#selectReview" styleClass="student-side-button" text="审核信息"/></VBox></left><center><VBox spacing="10"><padding><Insets bottom="14" left="18" right="22" top="18"/></padding><Label fx:id="adminWorkspaceTitle" styleClass="student-section-title" text="教师信息管理"/><HBox alignment="CENTER_LEFT" spacing="10" styleClass="student-export-toolbar"><Button fx:id="exportTeachersButton" disable="true" onAction="#exportSelectedTeachers" styleClass="student-export-action" text="↓  导出"/><Label fx:id="selectedTeacherCountLabel" styleClass="hint-text" text="已选择 0 人"/></HBox><HBox alignment="CENTER_LEFT" spacing="8" styleClass="student-search-bar"><Label text="工号"/><TextField fx:id="teacherSearchIdField" prefWidth="145" promptText="支持工号片段"/><SearchClearButton target="$teacherSearchIdField"/><Label text="姓名"/><TextField fx:id="teacherSearchNameField" prefWidth="125" promptText="支持姓名片段"/><SearchClearButton target="$teacherSearchNameField"/><Label text="关键词"/><TextField fx:id="teacherSearchKeywordField" prefWidth="180" promptText="学院/部门/职称/状态"/><SearchClearButton target="$teacherSearchKeywordField"/><Region HBox.hgrow="ALWAYS"/><Button onAction="#refresh" styleClass="btn-primary" text="查询"/><Button styleClass="btn-secondary" text="重置"/></HBox>
      <TableView fx:id="teacherTable" VBox.vgrow="ALWAYS"><columns><TableColumn fx:id="selectCol" prefWidth="54" sortable="false"/><TableColumn fx:id="idCol" prefWidth="130" text="工号"/><TableColumn fx:id="nameCol" prefWidth="130" text="姓名"/><TableColumn fx:id="collegeCol" prefWidth="230" text="学院"/><TableColumn fx:id="departmentCol" prefWidth="190" text="部门"/><TableColumn fx:id="titleCol" prefWidth="130" text="职称"/><TableColumn fx:id="statusCol" prefWidth="130" text="任职状态"/><TableColumn fx:id="actionCol" prefWidth="110" text="操作"/></columns></TableView><HBox alignment="CENTER" spacing="8" styleClass="student-pagination"><Button text="上一页" onAction="#previousReviewPage"/><Label fx:id="reviewPageSummary"/><Button text="下一页" onAction="#nextReviewPage"/><Button styleClass="page-button" text="|&lt;"/><Button styleClass="page-button" text="&lt;"/><Label text="第 1 页"/><Button styleClass="page-button" text="&gt;"/><Button styleClass="page-button" text="&gt;|"/></HBox>
    </VBox></center></BorderPane></Tab>
    <Tab fx:id="reviewTab" text="信息审核"><BorderPane styleClass="student-page"><left><VBox alignment="TOP_CENTER" prefWidth="160" spacing="12" styleClass="student-sidebar"><padding><Insets left="14" right="14" top="24"/></padding><StackPane minHeight="70" minWidth="70" prefHeight="70" prefWidth="70" maxHeight="70" maxWidth="70" styleClass="student-avatar"><Label styleClass="avatar-text-lg" text="管"/></StackPane><Label styleClass="student-side-name" text="管理员"/><Button maxWidth="Infinity" onAction="#selectAdmin" styleClass="student-side-button" text="教师信息管理"/><Button maxWidth="Infinity" onAction="#selectAdmin" styleClass="student-side-button" text="教师信息维护"/><Button maxWidth="Infinity" styleClass="student-side-button-active" text="审核信息"/></VBox></left><center><VBox spacing="10"><padding><Insets bottom="14" left="18" right="22" top="18"/></padding><Label styleClass="student-section-title" text="修改申请总览"/><HBox spacing="0" styleClass="review-bucket-tabs"><ToggleButton fx:id="unfinishedReviewButton" onAction="#showUnfinishedReviews" selected="true" styleClass="review-bucket-tab" text="未完成"/><ToggleButton fx:id="completedReviewButton" onAction="#showCompletedReviews" styleClass="review-bucket-tab" text="已完成"/></HBox><HBox alignment="CENTER_LEFT" spacing="8" styleClass="student-search-bar"><Label text="教师工号"/><TextField fx:id="teacherReviewSearchIdField" prefWidth="155" promptText="搜索工号"/><SearchClearButton target="$teacherReviewSearchIdField"/><Label text="状态"/><TextField fx:id="teacherReviewSearchStatusField" prefWidth="145" promptText="待审核/已通过"/><SearchClearButton target="$teacherReviewSearchStatusField"/><Region HBox.hgrow="ALWAYS"/><Button onAction="#refresh" styleClass="btn-primary" text="查询"/><Button styleClass="btn-secondary" text="重置"/></HBox>
      <TableView fx:id="requestTable" VBox.vgrow="ALWAYS"><columns><TableColumn fx:id="requestNameCol" prefWidth="140" text="姓名"/><TableColumn fx:id="requestTeacherCol" prefWidth="180" text="教师工号"/><TableColumn fx:id="requestSubmitCol" prefWidth="260" text="提交时间"/><TableColumn fx:id="requestStatusCol" prefWidth="180" text="状态"/><TableColumn fx:id="requestReviewCol" prefWidth="260" text="处理时间"/><TableColumn fx:id="requestActionCol" prefWidth="150" text="操作"/></columns></TableView><HBox alignment="CENTER" spacing="8" styleClass="student-pagination"><Button text="上一页" onAction="#previousReviewPage"/><Label fx:id="reviewPageSummary"/><Button text="下一页" onAction="#nextReviewPage"/></HBox>
    </VBox></center></BorderPane></Tab>
  </tabs></TabPane></center>
  <bottom><HBox alignment="CENTER_LEFT" prefHeight="28" styleClass="student-statusbar"><padding><Insets left="22"/></padding><Label fx:id="statusLabel" text="就绪"/></HBox></bottom>
</BorderPane>
