                                                            </children>
                                                        </VBox>
                                                        <VBox alignment="CENTER" spacing="2.0" HBox.hgrow="ALWAYS" style="-fx-background-color: #ffffff; -fx-background-radius: 6px; -fx-padding: 6px 8px; -fx-border-color: #e2e8f0; -fx-border-radius: 6px;">
                                                            <children>
                                                                <Label styleClass="dash-info-key" text="累计绩点" style="-fx-font-size: 11px;" />
                                                                <Label fx:id="cumulativeGpaLabel" text="--" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #166534;" />
                                                            </children>
                                                        </VBox>
                                                        <VBox alignment="CENTER" spacing="2.0" HBox.hgrow="ALWAYS" style="-fx-background-color: #ffffff; -fx-background-radius: 6px; -fx-padding: 6px 8px; -fx-border-color: #e2e8f0; -fx-border-radius: 6px;">
                                                            <children>
                                                                <Label styleClass="dash-info-key" text="累计均分" style="-fx-font-size: 11px;" />
                                                                <Label fx:id="cumulativeAvgLabel" text="--" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #166534;" />
                                                            </children>
                                                        </VBox>
                                                    </children>
                                                </HBox>

                                                <!-- 学分完成进度 -->
                                                <VBox spacing="6.0" alignment="CENTER_LEFT" GridPane.columnIndex="1" style="-fx-background-color: #ffffff; -fx-background-radius: 6px; -fx-padding: 6px 12px; -fx-border-color: #e2e8f0; -fx-border-radius: 6px;">
                                                    <children>
                                                        <HBox alignment="CENTER_LEFT" spacing="6.0">
                                                            <children>
                                                                <Label styleClass="dash-info-key" text="培养方案学分进度" style="-fx-font-size: 11px;" />
                                                                <Region HBox.hgrow="ALWAYS" />
                                                                <Label fx:id="earnedCreditsLabel" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #151E49;" text="--" />
                                                                <Label text="/" style="-fx-text-fill: #94a3b8; -fx-font-size: 12px;" />
                                                                <Label fx:id="requiredCreditsLabel" style="-fx-font-size: 12px; -fx-text-fill: #64748b;" text="--" />
                                                                <Label text="学分" styleClass="dash-info-key" style="-fx-font-size: 11px;" />
                                                                <Label fx:id="creditPercentLabel" style="-fx-font-size: 11.5px; -fx-font-weight: bold; -fx-text-fill: #587558;" text="(--%)" />
                                                            </children>
                                                        </HBox>
                                                        <ProgressBar fx:id="creditProgressBar" maxWidth="1.7976931348623157E308" prefHeight="8.0" progress="0.0" styleClass="course-progress-bar" />
                                                    </children>
                                                </VBox>
                                            </children>
                                        </GridPane>
                                    </children>
                                </VBox>

                                <!-- 课表嵌入容器：动态加载对应角色的课表视图 -->
                                <StackPane fx:id="scheduleContainer" minHeight="520.0" VBox.vgrow="ALWAYS" />

                                <Label fx:id="courseCardTitle" visible="false" managed="false" />
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
