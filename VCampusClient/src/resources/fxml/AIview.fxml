<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="768.0" prefWidth="1024.0" styleClass="main-window" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.AiController">

    <!-- 顶部导航栏 -->
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="60.0" spacing="16.0" styleClass="chat-topbar" BorderPane.alignment="CENTER">
            <padding>
                <Insets left="20.0" right="20.0" />
            </padding>
            <children>
                <Button onAction="#handleBackToMain" styleClass="btn-secondary" text="← 返回应用中心" />
                <Label styleClass="chat-topbar-title" text="虚拟校园·AI智能助手" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="currentUserLabel" styleClass="chat-topbar-user" text="当前用户：师生" />
            </children>
        </HBox>
    </top>

    <!-- 左侧会话列表 -->
    <left>
        <VBox prefWidth="240.0" spacing="12.0" styleClass="chat-sidebar" BorderPane.alignment="CENTER">
            <children>
                <Button maxWidth="1.7976931348623157E308" onAction="#handleNewConversation" prefHeight="40.0" styleClass="btn-primary" text="+ 新建会话" />
                <Label styleClass="chat-section-subtitle" text="历史会话">
                    <VBox.margin>
                        <Insets top="8.0" />
                    </VBox.margin>
                </Label>
                <!-- 动态会话列表 -->
                <ScrollPane fitToWidth="true" styleClass="content-scroll-pane" VBox.vgrow="ALWAYS">
                    <content>
                        <VBox fx:id="conversationListContainer" spacing="6.0" />
                    </content>
                </ScrollPane>
            </children>
        </VBox>
    </left>

    <!-- 中间对话区 -->
    <center>
        <BorderPane styleClass="chat-content-pane" BorderPane.alignment="CENTER">
            <!-- 聊天标题 -->
            <top>
                <HBox alignment="CENTER_LEFT" prefHeight="60.0" styleClass="chat-content-header" BorderPane.alignment="CENTER">
                    <children>
                        <Label fx:id="currentSessionTitleLabel" styleClass="section-title" text="新对话" />
                    </children>
                </HBox>
            </top>

            <!-- 聊天记录区 -->
            <center>
                <ScrollPane fx:id="chatScrollPane" fitToWidth="true" styleClass="content-scroll-pane" BorderPane.alignment="CENTER">
                    <content>
                        <VBox fx:id="chatMessageList" spacing="18.0" styleClass="chat-message-list" />
                    </content>
                </ScrollPane>
            </center>

            <!-- 底部输入框区 -->
            <bottom>
                <VBox styleClass="chat-input-area" BorderPane.alignment="CENTER">
                    <children>
                        <VBox spacing="8.0" styleClass="chat-input-container">
                            <children>
                                <TextArea fx:id="inputTextArea" prefHeight="80.0" promptText="输入校园问题（按 Enter 发送，Shift+Enter 换行，建议不超过1000字）" styleClass="chat-textarea" wrapText="true" />
                                <HBox alignment="CENTER_RIGHT" spacing="15.0">
                                    <children>
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Label fx:id="statusLabel" styleClass="chat-status-label" text="就绪" />
                                        <Button fx:id="sendButton" onAction="#handleSendMessage" styleClass="btn-primary" text="发送" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </bottom>
        </BorderPane>
    </center>

    <!-- 右侧资料来源栏 -->
    <right>
        <VBox prefWidth="280.0" spacing="12.0" styleClass="chat-source-sidebar" BorderPane.alignment="CENTER">
            <children>
                <Label styleClass="section-title" text="资料来源与引用">
                    <VBox.margin>
                        <Insets bottom="4.0" />
                    </VBox.margin>
                </Label>

                <ScrollPane fitToWidth="true" styleClass="content-scroll-pane" VBox.vgrow="ALWAYS">
                    <content>
                        <VBox fx:id="citationsContainer" spacing="10.0" />
                    </content>
                </ScrollPane>

                <Label styleClass="source-warning" text="VCampus AI 助手依据校园资料生成，敏感操作须前往相关模块正式办理。" wrapText="true" />
            </children>
        </VBox>
    </right>
</BorderPane>
