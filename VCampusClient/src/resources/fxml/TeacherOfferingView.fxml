<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
  教学班列表页（设计 §5.1）：学期、课程/教学班搜索、分页列表，行由 DTO 驱动。
  本页由工作台通过 fx:include 装入；样式全部来自 teacher-course.css。
-->
<VBox spacing="10.0" styleClass="teacher-course-page" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.TeacherOfferingController">
    <children>
        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="teacher-course-toolbar">
            <children>
                <ComboBox fx:id="termFilter" prefWidth="200.0" promptText="学期" styleClass="teacher-course-term-filter" />
                <TextField fx:id="searchField" promptText="搜索课程名称、课程代码或教学班代码" styleClass="teacher-course-search-field" HBox.hgrow="ALWAYS" />
                <Button fx:id="refreshButton" onAction="#refresh" styleClass="teacher-course-refresh-button" text="刷新" />
            </children>
        </HBox>
        <Label fx:id="summaryLabel" styleClass="teacher-course-page-summary" text="" />
        <StackPane styleClass="teacher-course-list-area" VBox.vgrow="ALWAYS">
            <children>
                <TableView fx:id="offeringTable" styleClass="teacher-course-table">
                    <placeholder>
                        <Label fx:id="emptyLabel" maxWidth="520.0" styleClass="teacher-course-empty-state" text="没有符合条件的教学班" wrapText="true" />
                    </placeholder>
                    <columns>
                        <TableColumn fx:id="nameColumn" prefWidth="320.0" text="教学班" />
                        <TableColumn fx:id="codeColumn" prefWidth="110.0" text="课程代码" />
                        <TableColumn fx:id="creditColumn" prefWidth="70.0" text="学分" />
                        <TableColumn fx:id="countColumn" prefWidth="90.0" text="人数" />
                        <TableColumn fx:id="statusColumn" prefWidth="90.0" text="状态" />
                        <TableColumn fx:id="actionColumn" prefWidth="90.0" text="操作" />
                    </columns>
                </TableView>
                <VBox alignment="CENTER" maxHeight="-Infinity" spacing="10.0" styleClass="teacher-course-state-area" StackPane.alignment="TOP_CENTER">
                    <children>
                        <Label fx:id="loadingLabel" managed="false" styleClass="teacher-course-loading-text" text="正在加载教学班..." visible="false" />
                        <Label fx:id="errorLabel" managed="false" maxWidth="520.0" styleClass="teacher-course-error-text" text="" visible="false" />
                        <Button fx:id="errorRetryButton" managed="false" onAction="#refresh" styleClass="teacher-course-retry-button" text="重试" visible="false" />
                    </children>
                    <padding>
                        <Insets top="28.0" />
                    </padding>
                </VBox>
            </children>
        </StackPane>
        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="teacher-course-pager">
            <children>
                <Label fx:id="pageLabel" styleClass="teacher-course-page-label" text="" />
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="previousPageButton" onAction="#handlePreviousPage" styleClass="teacher-course-page-button" text="上一页" />
                <Button fx:id="nextPageButton" onAction="#handleNextPage" styleClass="teacher-course-page-button" text="下一页" />
            </children>
        </HBox>
    </children>
</VBox>
